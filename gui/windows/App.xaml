<Application x:Class="Copyist.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- No custom control templates anywhere in this app, on purpose.
             Restyling a control is the usual way an accessible toolkit stops
             being accessible; stock templates keep UI Automation correct. -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3"/>
        </Style>
    </Application.Resources>
</Application>
